<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy/MM/dd - HH:mm:ss}] %boldCyan(%-34.-34thread) %red(%10.10X{jda.shard}) %boldGreen(%-15.-15logger{0}) %highlight(%-6level) %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="DISCORD" class="de.grewdev.BotErrorLogger">
        <jda>${JDA_INSTANCE}</jda>
        <channelId>YOUR_CHANNEL_ID</channelId>

    </appender>

    <root level="error">
        <appender-ref ref="DISCORD" />
    </root>
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
